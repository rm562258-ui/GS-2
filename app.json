{
  "expo": {
    "name": "Nexus Verde",
    "slug": "nexus-verde",
    "owner": "luanpmr",
    "scheme": "nexusverde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.nexusverde.app"
    },
    "android": {
      "package": "br.com.nexusverde.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F5EE",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F8F6",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1411"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Nexus Verde usa sua localização para mostrar os pontos de água mais próximos e informar onde você precisa de ajuda.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "67a6c8a0-78e1-4a13-9928-01b9262e7210"
      }
    }
  }
}
